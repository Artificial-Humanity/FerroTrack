# Store connection details (URL, token) are invocation parameters, never repo
# contents — this is a public repo. .ferrostep/ is the untracked local home for
# them when a file is needed at all.
.ferrostep/

# Rust build output (the crate is coming; the ignore predates it on purpose).
target/

# Working notes live in the umbrella Notes/ repo and are deliberately private.
# This is a symlink to ../Notes/FerroTrack — never track it.
notes
